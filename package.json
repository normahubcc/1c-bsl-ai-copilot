{
  "name": "1c-bsl-ai-copilot",
  "displayName": "1C BSL AI Copilot (NormaHub)",
  "description": "Бесплатный AI-ассистент для разработчиков 1С:Предприятие (BSL) в VS Code и Cursor. Умный автокомплит на лету, конструктор запросов 1С и аудит стандартов ИТС без VPN.",
  "version": "1.0.1",
  "publisher": "normahub",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/normahubcc/1c-bsl-ai-copilot"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "1c",
    "bsl",
    "1c-enterprise",
    "onescript",
    "copilot",
    "normahub",
    "cursor",
    "vsc-language-1c-bsl"
  ],
  "activationEvents": [
    "onLanguage:bsl",
    "onLanguage:1c",
    "onLanguage:oscript",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "build": "npx esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify && npx esbuild ./src/mcp/server.ts --bundle --outfile=dist/mcp-server.js --format=cjs --platform=node",
    "package": "python3 build_vsix.py",
    "test": "node ./tests/test_runner.js && python3 -m unittest discover -s sidecar/tests/ -v",
    "sidecar": "python3 sidecar/main.py daemon",
    "mcp": "node bin/mcp-server-1c.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "normahub-1c-sidebar",
          "title": "1C Copilot",
          "icon": "media/1c-icon.svg"
        }
      ]
    },
    "views": {
      "normahub-1c-sidebar": [
        {
          "type": "webview",
          "id": "normahub1c.mainView",
          "name": "1С:Ассистент"
        }
      ]
    },
    "commands": [
      {
        "command": "normahub1c.generateQuery",
        "title": "1С: Сгенерировать запрос по описанию"
      },
      {
        "command": "normahub1c.generateBatchQuery",
        "title": "1С: Создать пакетный запрос с временными таблицами (ИТС)"
      },
      {
        "command": "normahub1c.generateExtensionMethod",
        "title": "1С: Сгенерировать метод для расширения (&Вместо / &ИзменениеИКонтроль)"
      },
      {
        "command": "normahub1c.bspAssistant",
        "title": "1С: Подобрать метод БСП (Библиотека Стандартных Подсистем)"
      },
      {
        "command": "normahub1c.auditStandards",
        "title": "1С: Проверить код по стандартам ИТС"
      },
      {
        "command": "normahub1c.inspectQuery",
        "title": "1С: Проверить оптимизацию запроса по стандартам ИТС"
      },
      {
        "command": "normahub1c.refactorQuery",
        "title": "1С: Оптимизировать запрос (Вынести в ВТ_ по стандартам ИТС)"
      },
      {
        "command": "normahub1c.generateVanessaFeature",
        "title": "1С: Сгенерировать BDD-сценарий (Vanessa-Automation)"
      },
      {
        "command": "normahub1c.analyzeTechLog",
        "title": "1С: Диагностика Технологического Журнала (ТЖ)"
      },
      {
        "command": "normahub1c.explainCode",
        "title": "1С: Объяснить фрагмент кода BSL"
      },
      {
        "command": "normahub1c.scanMetadata",
        "title": "1С: Просканировать метаданные конфигурации"
      },
      {
        "command": "normahub1c.topupBalance",
        "title": "1С: Пополнить баланс NormaHub (СБП/Диадок)"
      },
      {
        "command": "normahub1c.setApiKey",
        "title": "1С: Настроить API-ключ NormaHub"
      },
      {
        "command": "normahub1c.statusMenu",
        "title": "1С: Меню управления и баланса"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "normahub1c.generateQuery",
          "when": "editorTextFocus",
          "group": "normahub1c@1"
        },
        {
          "command": "normahub1c.generateBatchQuery",
          "when": "editorTextFocus",
          "group": "normahub1c@2"
        },
        {
          "command": "normahub1c.generateExtensionMethod",
          "when": "editorTextFocus",
          "group": "normahub1c@3"
        },
        {
          "command": "normahub1c.bspAssistant",
          "when": "editorTextFocus",
          "group": "normahub1c@4"
        },
        {
          "command": "normahub1c.auditStandards",
          "when": "editorHasSelection",
          "group": "normahub1c@5"
        },
        {
          "command": "normahub1c.inspectQuery",
          "when": "editorHasSelection",
          "group": "normahub1c@6"
        },
        {
          "command": "normahub1c.generateVanessaFeature",
          "when": "editorTextFocus",
          "group": "normahub1c@7"
        },
        {
          "command": "normahub1c.analyzeTechLog",
          "when": "editorTextFocus",
          "group": "normahub1c@8"
        },
        {
          "command": "normahub1c.explainCode",
          "when": "editorHasSelection",
          "group": "normahub1c@9"
        }
      ]
    },
    "keybindings": [
      {
        "command": "normahub1c.generateQuery",
        "key": "ctrl+alt+q",
        "mac": "cmd+alt+q",
        "when": "editorTextFocus"
      },
      {
        "command": "normahub1c.generateExtensionMethod",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus"
      },
      {
        "command": "normahub1c.bspAssistant",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus"
      },
      {
        "command": "normahub1c.auditStandards",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorHasSelection"
      },
      {
        "command": "normahub1c.generateVanessaFeature",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus"
      },
      {
        "command": "normahub1c.analyzeTechLog",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "1C BSL AI Copilot (NormaHub)",
      "properties": {
        "normahub1c.baseUrl": {
          "type": "string",
          "default": "https://api.normahub.cc/v1",
          "description": "Эндпоинт API-шлюза NormaHub"
        },
        "normahub1c.autocompleteModel": {
          "type": "string",
          "default": "deepseek-v4.1-flash",
          "enum": [
            "deepseek-v4.1-flash",
            "gpt-6.1-sol",
            "gpt-6-sol",
            "gpt-6-astra",
            "glm-5.3-flash",
            "muse-spark-1.3"
          ],
          "enumDescriptions": [
            "DeepSeek v4.1 Flash (★ Рекомендуется для 1С, сверхбыстрая и экономичная)",
            "GPT-6.1 Sol (Флагман OpenAI, сложнейшая логика и архитектура)",
            "GPT-6 Sol (Высокая точность и сложные рассуждения)",
            "GPT-6 Astra (Сбалансированная модель)",
            "GLM 5.3 Flash (Сверхскоростная модель от Z.ai)",
            "Muse Spark 1.3 (Креативность, комментарии и документация)"
          ],
          "description": "Модель для мгновенного автокомплита BSL и кодогенерации"
        },
        "normahub1c.reasoningModel": {
          "type": "string",
          "default": "gpt-6.1-sol",
          "enum": [
            "deepseek-v4.1-flash",
            "gpt-6.1-sol",
            "gpt-6-sol",
            "gpt-6-astra",
            "glm-5.3-flash",
            "muse-spark-1.3"
          ],
          "description": "Модель для генерации сложных запросов 1С и глубокого рефакторинга"
        },
        "normahub1c.enableInlineCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Включить умное автодополнение Ghost Text на лету"
        },
        "normahub1c.debounceMs": {
          "type": "number",
          "default": 250,
          "description": "Задержка дебаунсинга автокомплита в мс перед отправкой в сеть"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
