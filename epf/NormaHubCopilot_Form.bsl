&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    // Инициализация реквизитов формы по умолчанию
    Если ПустаяСтрока(Объект.ХостSidecar) Тогда
        Объект.ХостSidecar = "127.0.0.1";
    КонецЕсли;
    Если Объект.ПортSidecar = 0 Тогда
        Объект.ПортSidecar = 18833;
    КонецЕсли;

    Объект.ПутьКФайлуМетаданных = "metadata.json";
    Объект.ИмяДокумента = "РеализацияТоваровУслуг";
    Объект.ТабличнаяЧасть = "Товары";
    Объект.ИмяРегистра = "ТоварыНаСкладах";
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузитьМетаданные(Команда)
    ОчиститьСообщения();
    
    ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    ДиалогВыбора.Заголовок = "Выберите файл для сохранения метаданных конфигурации";
    ДиалогВыбора.Фильтр = "JSON файлы (*.json)|*.json";
    ДиалогВыбора.ПолноеИмяФайла = "metadata.json";

    Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайлаМетаданных", ЭтотОбъект);
    ДиалогВыбора.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайлаМетаданных(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
    Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ВыбранныйПуть = ВыбранныеФайлы[0];
    Попытка
        ВыгрузитьМетаданныеНаСервере(ВыбранныйПуть);
        ПоказатьОповещениеПользователя(
            "Выгрузка завершена",
            ,
            "Структура метаданных успешно выгружена в: " + ВыбранныйПуть,
            БиблиотекаКартинок.Информация32
        );
    Исключение
        ПоказатьПредупреждение(, ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьМетаданныеНаСервере(Знач ПутьКФайлу)
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ОбработкаОбъект.Инициализировать(Объект.ХостSidecar, Объект.ПортSidecar);
    ОбработкаОбъект.ВыгрузитьМетаданныеВJSON(ПутьКФайлу);
КонецПроцедуры

&НаКлиенте
Процедура КомандаПроверитьКод(Команда)
    ОчиститьСообщения();
    Если ПустаяСтрока(Объект.ИсходныйКодBSL) Тогда
        ПоказатьПредупреждение(, "Введите или вставьте BSL-код для проверки.");
        Возврат;
    КонецЕсли;

    Попытка
        РезультатАудита = ВыполнитьАудитКодаНаСервере(Объект.ИсходныйКодBSL);
        Объект.РезультатПроверкиИТС = "";
        
        Если РезультатАудита.Свойство("issues") Тогда
            Для Каждого Замечание Из РезультатАудита.issues Цикл
                Значок = ?(Замечание.severity = "error", "🔴", "🟡");
                Объект.РезультатПроверкиИТС = Объект.РезультатПроверкиИТС 
                    + Значок + " [Стр. " + Строка(Замечание.line) + "] " + Замечание.rule + ": " + Замечание.message + Символы.ПС
                    + "   💡 " + Замечание.suggestion + Символы.ПС + Символы.ПС;
            КонецЦикла;
            
            Если РезультатАудита.issuesCount = 0 Тогда
                Объект.РезультатПроверкиИТС = "✓ Замечаний по стандартам разработки фирмы «1С» (ИТС) не обнаружено!";
            КонецЕсли;
        КонецЕсли;
    Исключение
        ПоказатьПредупреждение(, ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ВыполнитьАудитКодаНаСервере(Знач ИсходныйТекст)
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ОбработкаОбъект.Инициализировать(Объект.ХостSidecar, Объект.ПортSidecar);
    Возврат ОбработкаОбъект.ВыполнитьАудитКодаИТС(ИсходныйТекст);
КонецФункции

&НаКлиенте
Процедура КомандаСгенерироватьЗапрос(Команда)
    Попытка
        Результат = СгенерироватьЗапросНаСервере(Объект.ИмяДокумента, Объект.ТабличнаяЧасть, Объект.ИмяРегистра);
        Если Результат.Свойство("code") Тогда
            Объект.СгенерированныйКод = Результат.code;
        КонецЕсли;
    Исключение
        ПоказатьПредупреждение(, ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция СгенерироватьЗапросНаСервере(Знач Документ, Знач ТЧ, Знач Регистр)
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ОбработкаОбъект.Инициализировать(Объект.ХостSidecar, Объект.ПортSidecar);
    Возврат ОбработкаОбъект.СгенерироватьПакетныйЗапрос(Документ, ТЧ, Регистр);
КонецФункции

&НаКлиенте
Процедура КомандаСгенерироватьBDD(Команда)
    Попытка
        Результат = СгенерироватьBDDНаСервере(Объект.ИмяДокумента, Объект.ТабличнаяЧасть, Объект.ИмяРегистра);
        Если Результат.Свойство("feature") Тогда
            Объект.СгенерированныйКод = Результат.feature;
        КонецЕсли;
    Исключение
        ПоказатьПредупреждение(, ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция СгенерироватьBDDНаСервере(Знач Документ, Знач ТЧ, Знач Регистр)
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ОбработкаОбъект.Инициализировать(Объект.ХостSidecar, Объект.ПортSidecar);
