// NormaHub AI Copilot для 1С:Предприятие 8.3
// Модуль управляемой формы внешней обработки
// --------------------------------------------------------------------------------

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    // Инициализация реквизитов формы по умолчанию
    Если ПустаяСтрока(Объект.ХостSidecar) Тогда
        Объект.ХостSidecar = "127.0.0.1";
    КонецЕсли;
    Если Объект.ПортSidecar = 0 Тогда
        Объект.ПортSidecar = 18833;
    КонецЕсли;

    Объект.ПутьКФайлуМетаданных = "";
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузитьМетаданные(Команда)
    Если ПустаяСтрока(Объект.ПутьКФайлуМетаданных) Тогда
        ПоказатьПредупреждение(, "Укажите абсолютный путь к metadata.json на сервере 1С.");
        Возврат;
    КонецЕсли;
    Попытка
        ВыгрузитьМетаданныеНаСервере(Объект.ПутьКФайлуМетаданных);
        ПоказатьОповещениеПользователя("Метаданные сохранены на сервере 1С", , Объект.ПутьКФайлуМетаданных);
    Исключение
        ПоказатьПредупреждение(, ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьМетаданныеНаСервере(Знач ПутьКФайлу)
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ОбработкаОбъект.Инициализировать(Объект.ХостSidecar, Объект.ПортSidecar, Объект.ТокенSidecar);
    ОбработкаОбъект.ВыгрузитьМетаданныеВJSON(ПутьКФайлу);
КонецПроцедуры

&НаКлиенте
Процедура КомандаПроверитьКод(Команда)
    ОчиститьСообщения();
    Если ПустаяСтрока(Объект.ИсходныйКодBSL) Тогда
        ПоказатьПредупреждение(, "Введите или вставьте BSL-код для проверки.");
        Возврат;
    КонецЕсли;

    Попытка
        РезультатАудита = ВыполнитьАудитКодаНаСервере(Объект.ИсходныйКодBSL);
        Объект.РезультатПроверкиИТС = "";
        
        Если РезультатАудита.Свойство("issues") Тогда
            Для Каждого Замечание Из РезультатАудита.issues Цикл
                Значок = ?(Замечание.severity = "error", "🔴", "🟡");
                Объект.РезультатПроверкиИТС = Объект.РезультатПроверкиИТС 
                    + Значок + " [Стр. " + Строка(Замечание.line) + "] " + Замечание.rule + ": " + Замечание.message + Символы.ПС
                    + "   💡 " + Замечание.suggestion + Символы.ПС + Символы.ПС;
            КонецЦикла;
            
            Если РезультатАудита.issuesCount = 0 Тогда
                Объект.РезультатПроверкиИТС = "Совпадений по реализованным локальным правилам нет. Проверьте поведение в 1С.";
            КонецЕсли;
        КонецЕсли;
    Исключение
        ПоказатьПредупреждение(, ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ВыполнитьАудитКодаНаСервере(Знач ИсходныйТекст)
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ОбработкаОбъект.Инициализировать(Объект.ХостSidecar, Объект.ПортSidecar, Объект.ТокенSidecar);
    Возврат ОбработкаОбъект.ВыполнитьАудитКодаИТС(ИсходныйТекст);
КонецФункции

&НаКлиенте
Процедура КомандаСгенерироватьЗапрос(Команда)
    Попытка
        Результат = СгенерироватьЗапросНаСервере(Объект.ИмяДокумента, Объект.ТабличнаяЧасть, Объект.ИмяРегистра, Объект.ПоляЗапроса);
        Если Результат.Свойство("code") Тогда
            Объект.СгенерированныйКод = Результат.code;
        КонецЕсли;
    Исключение
        ПоказатьПредупреждение(, ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция СгенерироватьЗапросНаСервере(Знач Документ, Знач ТЧ, Знач Регистр, Знач ИменаПолей)
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ОбработкаОбъект.Инициализировать(Объект.ХостSidecar, Объект.ПортSidecar, Объект.ТокенSidecar);
    Возврат ОбработкаОбъект.СгенерироватьПакетныйЗапрос(Документ, ТЧ, Регистр, СтрРазделить(ИменаПолей, ",", Ложь));
КонецФункции

&НаКлиенте
Процедура КомандаСгенерироватьBDD(Команда)
    Попытка
        Результат = СгенерироватьBDDНаСервере(Объект.ИмяДокумента, Объект.ТабличнаяЧасть, Объект.ИмяРегистра);
        Если Результат.Свойство("feature") Тогда
            Объект.СгенерированныйКод = Результат.feature;
        КонецЕсли;
    Исключение
        ПоказатьПредупреждение(, ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция СгенерироватьBDDНаСервере(Знач Документ, Знач ТЧ, Знач Регистр)
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ОбработкаОбъект.Инициализировать(Объект.ХостSidecar, Объект.ПортSidecar, Объект.ТокенSidecar);
    Возврат ОбработкаОбъект.СгенерироватьBDDСценарий(Документ, ТЧ, Регистр);
КонецФункции

&НаКлиенте
Процедура КомандаАнализТЖ(Команда)
    Если ПустаяСтрока(Объект.ЛогТЖ) Тогда
        ПоказатьПредупреждение(, "Вставьте фрагмент Технологического Журнала (ТЖ) для анализа.");
        Возврат;
    КонецЕсли;

    Попытка
        Результат = АнализироватьЛогТЖНаСервере(Объект.ЛогТЖ);
        Если Результат.Свойство("report") Тогда
            Объект.РезультатАнализаТЖ = Результат.report;
        КонецЕсли;
    Исключение
        ПоказатьПредупреждение(, ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция АнализироватьЛогТЖНаСервере(Знач ТекстТЖ)
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ОбработкаОбъект.Инициализировать(Объект.ХостSidecar, Объект.ПортSidecar, Объект.ТокенSidecar);
    Возврат ОбработкаОбъект.АнализироватьЛогТЖ(ТекстТЖ);
КонецФункции
