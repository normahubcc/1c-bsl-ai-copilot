// --------------------------------------------------------------------------------
// NormaHub AI Copilot для 1С:Предприятие 8.3
// Модуль объекта внешней обработки: Экспорт метаданных и клиент Sidecar
// --------------------------------------------------------------------------------

Перем АдресSidecar; // Строка, по умолчанию "127.0.0.1"
Перем ПортSidecar;  // Число, по умолчанию 18833

#Область Инициализация

Процедура Инициализировать(Хост = "127.0.0.1", Порт = 18833) Экспорт
    АдресSidecar = Хост;
    ПортSidecar = Порт;
КонецПроцедуры

#КонецОбласти

#Область ЭкспортМетаданных

// Выгружает полную структуру метаданных текущей информационной базы в JSON-файл
// Формат полностью совместим с MetadataScanner и RAG-контекстом NormaHub
Функция ВыгрузитьМетаданныеВJSON(Знач ПутьКФайлу) Экспорт
    Если ПустаяСтрока(ПутьКФайлу) Тогда
        ВызватьИсключение "Не указан путь к файлу для выгрузки метаданных.";
    КонецЕсли;

    СтруктураМетаданных = Новый Структура;
    СтруктураМетаданных.Вставить("name", Метаданные.Имя);
    СтруктураМетаданных.Вставить("synonym", Метаданные.Синоним);
    СтруктураМетаданных.Вставить("version", Метаданные.Версия);
    СтруктураМетаданных.Вставить("compatibilityMode", Строка(Метаданные.РежимСовместимостиИнтерфейса));

    СписокОбъектов = Новый Массив;

    // 1. Справочники
    Для Каждого Мд Из Метаданные.Справочники Цикл
        ОбъектИнфо = СобратьИнформациюОбОбъекте("Справочник", Мд);
        СписокОбъектов.Добавить(ОбъектИнфо);
    КонецЦикла;

    // 2. Документы
    Для Каждого Мд Из Метаданные.Документы Цикл
        ОбъектИнфо = СобратьИнформациюОбОбъекте("Документ", Мд);
        СписокОбъектов.Добавить(ОбъектИнфо);
    КонецЦикла;

    // 3. Регистры накопления
    Для Каждого Мд Из Метаданные.РегистрыНакопления Цикл
        ОбъектИнфо = СобратьИнформациюОРегистре("РегистрНакопления", Мд);
        СписокОбъектов.Добавить(ОбъектИнфо);
    КонецЦикла;

    // 4. Регистры сведений
    Для Каждого Мд Из Метаданные.РегистрыСведений Цикл
        ОбъектИнфо = СобратьИнформациюОРегистре("РегистрСведений", Мд);
        СписокОбъектов.Добавить(ОбъектИнфо);
    КонецЦикла;

    // 5. Планы видов характеристик
    Для Каждого Мд Из Метаданные.ПланыВидовХарактеристик Цикл
        ОбъектИнфо = СобратьИнформациюОбОбъекте("ПланВидовХарактеристик", Мд);
        СписокОбъектов.Добавить(ОбъектИнфо);
    КонецЦикла;

    СтруктураМетаданных.Вставить("objects", СписокОбъектов);

    // Сериализация в файл JSON с UTF-8
    ЗаписьJSON = Новый ЗаписьJSON;
    ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");
    ЗаписьJSON.ОткрытьФайл(ПутьКФайлу,,, ПараметрыЗаписи);
    ЗаписатьJSON(ЗаписьJSON, СтруктураМетаданных);
    ЗаписьJSON.Закрыть();

    Возврат Истина;
КонецФункции

Функция СобратьИнформациюОбОбъекте(Знач ВидОбъекта, Знач Мд)
    Инфо = Новый Структура;
    Инфо.Вставить("kind", ВидОбъекта);
    Инфо.Вставить("name", Мд.Имя);
    Инфо.Вставить("synonym", ?(ПустаяСтрока(Мд.Синоним), Мд.Имя, Мд.Синоним));

    // Реквизиты объекта
    МассивПолей = Новый Массив;
    Для Каждого Реквизит Из Мд.Реквизиты Цикл
        ПолеИнфо = Новый Структура;
        ПолеИнфо.Вставить("name", Реквизит.Имя);
        ПолеИнфо.Вставить("synonym", ?(ПустаяСтрока(Реквизит.Синоним), Реквизит.Имя, Реквизит.Синоним));
        ПолеИнфо.Вставить("type", Строка(Реквизит.Тип));
        МассивПолей.Добавить(ПолеИнфо);
    КонецЦикла;
    Инфо.Вставить("fields", МассивПолей);

    // Табличные части
    МассивТЧ = Новый Массив;
    Для Каждого ТЧ Из Мд.ТабличныеЧасти Цикл
        ТЧИнфо = Новый Структура;
        ТЧИнфо.Вставить("name", ТЧ.Имя);
        ТЧИнфо.Вставить("synonym", ?(ПустаяСтрока(ТЧ.Синоним), ТЧ.Имя, ТЧ.Синоним));

        РеквизитыТЧ = Новый Массив;
        Для Каждого РеквизитТЧ Из ТЧ.Реквизиты Цикл
            РеквизитИнфо = Новый Структура;
            РеквизитИнфо.Вставить("name", РеквизитТЧ.Имя);
            РеквизитИнфо.Вставить("synonym", ?(ПустаяСтрока(РеквизитТЧ.Синоним), РеквизитТЧ.Имя, РеквизитТЧ.Синоним));
            РеквизитИнфо.Вставить("type", Строка(РеквизитТЧ.Тип));
            РеквизитыТЧ.Добавить(РеквизитИнфо);
        КонецЦикла;
        ТЧИнфо.Вставить("fields", РеквизитыТЧ);
        МассивТЧ.Добавить(ТЧИнфо);
    КонецЦикла;
    Инфо.Вставить("tabularSections", МассивТЧ);

    Возврат Инфо;
КонецФункции

Функция СобратьИнформациюОРегистре(Знач ВидРегистра, Знач Мд)
    Инфо = Новый Структура;
    Инфо.Вставить("kind", ВидРегистра);
    Инфо.Вставить("name", Мд.Имя);
    Инфо.Вставить("synonym", ?(ПустаяСтрока(Мд.Синоним), Мд.Имя, Мд.Синоним));

    МассивПолей = Новый Массив;

    // Измерения
    Для Каждого Измерение Из Мд.Измерения Цикл
        ПолеИнфо = Новый Структура;
        ПолеИнфо.Вставить("name", Измерение.Имя);
        ПолеИнфо.Вставить("role", "Измерение");
        ПолеИнфо.Вставить("type", Строка(Измерение.Тип));
        МассивПолей.Добавить(ПолеИнфо);
    КонецЦикла;

    // Ресурсы
    Для Каждого Ресурс Из Мд.Ресурсы Цикл
        ПолеИнфо = Новый Структура;
        ПолеИнфо.Вставить("name", Ресурс.Имя);
        ПолеИнфо.Вставить("role", "Ресурс");
        ПолеИнфо.Вставить("type", Строка(Ресурс.Тип));
        МассивПолей.Добавить(ПолеИнфо);
    КонецЦикла;

    // Реквизиты
    Для Каждого Реквизит Из Мд.Реквизиты Цикл
        ПолеИнфо = Новый Структура;
        ПолеИнфо.Вставить("name", Реквизит.Имя);
        ПолеИнфо.Вставить("role", "Реквизит");
        ПолеИнфо.Вставить("type", Строка(Реквизит.Тип));
        МассивПолей.Добавить(ПолеИнфо);
    КонецЦикла;

    Инфо.Вставить("fields", МассивПолей);
    Возврат Инфо;
КонецФункции

#КонецОбласти

#Область ВзаимодействиеСSidecar

// Отправляет POST-запрос к локальному Sidecar-демону
Функция ОтправитьЗапросКSidecar(Знач ПутьЭндпоинта, Знач ДанныеЗапросаСтруктура) Экспорт
    Если ПустаяСтрока(АдресSidecar) Тогда
        АдресSidecar = "127.0.0.1";
    КонецЕсли;
    Если ПортSidecar = Неопределено Или ПортSidecar = 0 Тогда
        ПортSidecar = 18833;
    КонецЕсли;

    // Сериализация тела в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеЗапросаСтруктура);
    СтрокаТела = ЗаписьJSON.Закрыть();

    // Создание HTTP-соединения
    Соединение = Новый HTTPСоединение(АдресSidecar, ПортSidecar,,,,, Новый ЗащищенноеСоединениеOpenSSL(), Ложь);
    Запрос = Новый HTTPЗапрос(ПутьЭндпоинта);
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.УстановитьТелоИзСтроки(СтрокаТела, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

    Попытка
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        Если Ответ.КодСостояния = 200 Тогда
            ЧтениеJSON = Новый ЧтениеJSON;
            ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
            РезультатСтруктура = ПрочитатьJSON(ЧтениеJSON);
            ЧтениеJSON.Закрыть();
            Возврат РезультатСтруктура;
        Иначе
            ВызватьИсключение "Ошибка Sidecar HTTP " + Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку();
        КонецЕсли;
    Исключение
        ИнформацияОбОшибке = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
        ВызватьИсключение "Не удалось соединиться с NormaHub Sidecar на " + АдресSidecar + ":" + ПортSidecar + ". Причина: " + ИнформацияОбОшибке;
    КонецПопытки;
КонецФункции

// 1. Аудит кода по стандартам ИТС
Функция ВыполнитьАудитКодаИТС(Знач ИсходныйТекстBSL) Экспорт
    Тело = Новый Структура("code", ИсходныйТекстBSL);
    Возврат ОтправитьЗапросКSidecar("/v1/audit", Тело);
КонецФункции

// 2. Генерация пакета запросов с временными таблицами
Функция СгенерироватьПакетныйЗапрос(Знач ИмяДокумента, Знач ТабличнаяЧасть, Знач ИмяРегистра) Экспорт
    Тело = Новый Структура;
    Тело.Вставить("entity", ИмяДокумента);
    Тело.Вставить("tabular", ТабличнаяЧасть);
    Тело.Вставить("register", ИмяРегистра);
    Возврат ОтправитьЗапросКSidecar("/v1/query", Тело);
КонецФункции

// 3. Генерация перехватчика расширения (cfe)
Функция СгенерироватьМетодРасширения(Знач ИмяМетода, Знач Директива, Знач МассивПараметров, Знач ЭтоФункция = Ложь) Экспорт
    Тело = Новый Структура;
    Тело.Вставить("method", ИмяМетода);
    Тело.Вставить("directive", Директива);
    Тело.Вставить("params", МассивПараметров);
    Тело.Вставить("isFunction", ЭтоФункция);
    Возврат ОтправитьЗапросКSidecar("/v1/extension", Тело);
КонецФункции

// 4. Генерация сценария Vanessa-Automation BDD
Функция СгенерироватьBDDСценарий(Знач ИмяДокумента, Знач ТабличнаяЧасть, Знач ИмяРегистра) Экспорт
    Тело = Новый Структура;
    Тело.Вставить("entity", ИмяДокумента);
    Тело.Вставить("tabular", ТабличнаяЧасть);
    Тело.Вставить("register", ИмяРегистра);
    Возврат ОтправитьЗапросКSidecar("/v1/bdd", Тело);
КонецФункции

// 5. Диагностика Технологического Журнала (ТЖ)
Функция АнализироватьЛогТЖ(Знач ИсходныйЛогТЖ) Экспорт
    Тело = Новый Структура("rawLog", ИсходныйЛогТЖ);
    Возврат ОтправитьЗапросКSidecar("/v1/techlog", Тело);
КонецФункции

#КонецОбласти
