// ==============================================================================
// Скрипт интеграции NormaHub AI Copilot для TurboConf (1С:Конфигуратор)
// Язык: OneScript / BSL
//
// Возможности:
// 1. Горячая клавиша [Ctrl+Alt+Space] — Умный автокомплит BSL прямо в позиции курсора
// 2. Горячая клавиша [Ctrl+Alt+I] — Мгновенный ИТС-аудит выделенного кода
// ==============================================================================

Перем АдресSidecar;
Перем ПортSidecar;

АдресSidecar = "127.0.0.1";
ПортSidecar = 18833;

#Область ИнициализацияTurboConf

// Регистрация команд и горячих клавиш в TurboConf
Процедура ПриЗапуске() Экспорт
    Попытка
        ТурбоКонф.ДобавитьКоманду("NormaHub_Автокомплит", "NormaHub: Дописать код (AI Copilot)", "КомандаАвтокомплит");
        ТурбоКонф.ЗарегистрироватьГорячуюКлавишу("Ctrl+Alt+Space", "КомандаАвтокомплит");

        ТурбоКонф.ДобавитьКоманду("NormaHub_ИТС_Аудит", "NormaHub: Аудит кода по стандартам ИТС", "КомандаИТСАудит");
        ТурбоКонф.ЗарегистрироватьГорячуюКлавишу("Ctrl+Alt+I", "КомандаИТСАудит");

        ТурбоКонф.ПоказатьОповещение(
            "NormaHub AI Copilot",
            "Интеграция с Конфигуратором успешно активирована [Ctrl+Alt+Space]",
            3000
        );
    Исключение
        // Если скрипт запускается вне TurboConf (например, через автономный OneScript CLI)
        Сообщить("Скрипт NormaHub Copilot готов к работе под TurboConf: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область Команды

// 1. Автокомплит в позиции курсора (Ctrl+Alt+Space)
Процедура КомандаАвтокомплит() Экспорт
    ВыделенныйКод = ТурбоКонф.ПолучитьВыделенныйТекст();
    Если ПустаяСтрока(ВыделенныйКод) Тогда
        // Если ничего не выделено, берем текст вокруг курсора
        ВыделенныйКод = ТурбоКонф.ПолучитьТекст();
    КонецЕсли;

    Если ПустаяСтрока(ВыделенныйКод) Тогда
        ТурбоКонф.ПоказатьОповещение("NormaHub Copilot", "Текст модуля пуст.", 2000);
        Возврат;
    КонецЕсли;

    ТурбоКонф.ПоказатьОповещение("NormaHub Copilot", "Генерация дополнения кода через API...", 1500);

    ПараметрыЗапроса = Новый Структура;
    ПараметрыЗапроса.Вставить("prompt", "Продолжи BSL-код на основе контекста выше");
    ПараметрыЗапроса.Вставить("code", ВыделенныйКод);

    Попытка
        Ответ = ОтправитьЗапросКSidecar("/v1/complete", ПараметрыЗапроса);
        Если Ответ <> Неопределено И Ответ.Свойство("result") Тогда
            СгенерированныйКод = Ответ.result;
            Если Не ПустаяСтрока(СгенерированныйКод) Тогда
                ТурбоКонф.ВставитьТекст(СгенерированныйКод);
                ТурбоКонф.ПоказатьОповещение("NormaHub Copilot", "✓ Код успешно сгенерирован и вставлен", 2000);
            КонецЕсли;
        КонецЕсли;
    Исключение
        ТурбоКонф.ПоказатьОповещение("NormaHub Ошибка", "Не удалось связаться с Sidecar: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 5000);
    КонецПопытки;
КонецПроцедуры

// 2. Аудит кода по стандартам ИТС (Ctrl+Alt+I)
Процедура КомандаИТСАудит() Экспорт
    ВыделенныйКод = ТурбоКонф.ПолучитьВыделенныйТекст();
    Если ПустаяСтрока(ВыделенныйКод) Тогда
        ВыделенныйКод = ТурбоКонф.ПолучитьТекст();
    КонецЕсли;

    ПараметрыЗапроса = Новый Структура("code", ВыделенныйКод);

    Попытка
        Ответ = ОтправитьЗапросКSidecar("/v1/audit", ПараметрыЗапроса);
        Если Ответ <> Неопределено И Ответ.Свойство("issues") Тогда
            КоличествоОшибок = Ответ.issues.Количество();
            Если КоличествоОшибок = 0 Тогда
                ТурбоКонф.ПоказатьОповещение("NormaHub ИТС Аудит", "✓ Замечаний не обнаружено! Код соответствует стандартам ИТС.", 4000);
            Иначе
                ТекстОтчета = "Найдено замечаний: " + КоличествоОшибок + Символы.ПС;
                Для Каждого Замечание Из Ответ.issues Цикл
                    ТекстОтчета = ТекстОтчета + "• [Стр. " + Замечание.line + "] " + Замечание.rule + ": " + Замечание.message + Символы.ПС;
                КонецЦикла;
                ТурбоКонф.ПоказатьОповещение("NormaHub ИТС Аудит", ТекстОтчета, 8000);
            КонецЕсли;
        КонецЕсли;
    Исключение
        ТурбоКонф.ПоказатьОповещение("NormaHub Ошибка", "Не удалось выполнить аудит: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 5000);
    КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область HTTP_Клиент

Функция ОтправитьЗапросКSidecar(Знач Путь, Знач ДанныеСтруктура)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеСтруктура);
    СтрокаТела = ЗаписьJSON.Закрыть();

    Соединение = Новый HTTPСоединение(АдресSidecar, ПортSidecar,,,,15);
    Запрос = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    ТокенSidecar = ПолучитьПеременнуюСреды("SIDECAR_AUTH_TOKEN");
    Если Не ПустаяСтрока(ТокенSidecar) Тогда
        Запрос.Заголовки.Вставить("Authorization", "Bearer " + ТокенSidecar);
    КонецЕсли;
    Запрос.УстановитьТелоИзСтроки(СтрокаТела, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

    Ответ = Соединение.ОтправитьДляОбработки(Запрос);
    Если Ответ.КодСостояния = 200 Тогда
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
        Результат = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        Возврат Результат;
    КонецЕсли;

    Возврат Неопределено;
КонецФункции

#КонецОбласти

ПриЗапуске();
